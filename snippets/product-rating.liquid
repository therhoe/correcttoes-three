{%- doc -%}
  Renders a product star rating: the stars, plus an optional review count.

  Extracted from blocks/review.liquid so that cards rendered outside the block
  system can reuse it without duplicating the star SVG defs. The markup here is
  byte-for-byte what blocks/review.liquid used to emit inline; blocks/review.liquid
  is now a thin wrapper over this snippet.

  Callers: blocks/review.liquid, snippets/color-variant-card.liquid.

  NOTE ON BOOLEANS: do not add `| default:` to the boolean params. In Liquid the
  `default` filter treats `false` as empty, so `false | default: true` yields true.
  Omitted booleans are nil, which is falsy, which is the intended behavior.

  @param {object} product - Product whose `metafields.reviews` values are read.
  @param {string} [stars_style] - 'outline' | 'shaded' | 'single'. Defaults to 'shaded'.
  @param {boolean} [show_number] - Show the review count. Falsy when omitted.
  @param {boolean} [show_divider] - Render a '|' before the count. Always on for 'single'.
  @param {boolean} [show_review_label] - Append the localized "reviews" word.
  @param {string} [rating_color] - 'foreground' | 'primary'. Defaults to 'primary'.
  @param {string} [type_preset] - Typography preset. Defaults to 'paragraph'.
  @param {string} [alignment] - 'left' | 'center' | 'right'. Defaults to 'left'.
  @param {string} [size_style] - Pre-rendered inline style for the wrapper, from
    `{% render 'size-style', settings: ... %}`. Optional.
  @param {string} [shopify_attributes] - block.shopify_attributes, when called from a block.

  @example
  {% render 'product-rating',
    product: closest.product,
    stars_style: 'shaded',
    show_number: true,
    show_divider: true,
    rating_color: 'foreground',
    type_preset: 'h5',
    alignment: 'left'
  %}
{%- enddoc -%}

{% liquid
  assign stars_style = stars_style | default: 'shaded'
  assign rating_color = rating_color | default: 'primary'
  assign type_preset = type_preset | default: 'paragraph'
  assign alignment = alignment | default: 'left'

  assign rating = product.metafields.reviews.rating.value.rating
  assign scale_max = product.metafields.reviews.rating.value.scale_max
  assign rating_count = product.metafields.reviews.rating_count

  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
    assign rating = product.metafields.reviews.rating.value | default: 4
    assign scale_max = product.metafields.reviews.rating.value.scale_max | default: 5
    assign rating_count = product.metafields.reviews.rating_count | default: 3
  endif
-%}

{%- if rating != blank -%}
  {% liquid
    assign star_count_rating = scale_max
    assign decimal_rating = 0
    assign decimal = rating | modulo: 1

    if decimal >= 0.3 and decimal <= 0.7
      assign decimal_rating = 0.5
    elsif decimal > 0.7
      assign decimal_rating = 1
    endif

    # this is used so I can tell how many stars I need to fill. When the decimal rating above is 0.5 or 1 I count it as one as the half star is dealt with with a SVG linear gradient.
    assign decimal_rounded = decimal_rating | ceil

    assign svg_filled_stars = rating | floor | plus: decimal_rounded

    assign render_divider = false
    if show_number and stars_style == 'single'
      assign render_divider = true
    elsif show_number and show_divider
      assign render_divider = true
    endif
  %}

  <div
    class="rating-wrapper rating-color--{{ rating_color }} justify-{{ alignment }} size-style"
    style="{{ size_style }}"
    {{ shopify_attributes }}
  >
    <svg
      class="visually-hidden"
      style="width: 0; height: 0;"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 32 32"
      role="presentation"
    >
      <defs>
        <linearGradient id="half" x1="0" x2="100%" y1="0" y2="0">
          <stop offset="50%" stop-color="var(--star-fill-color)"></stop>
          <stop offset="50%" stop-color="{% if stars_style == "outline" %}transparent{% else %}rgb(var(--star-fill-color-rgb) / var(--opacity-20){% endif %}"></stop>
        </linearGradient>

        <symbol xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" id="star">
          <path d="M31.547 12a.848.848 0 00-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 00-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 00-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 001.23.893l8.428-4.434 8.432 4.432a.847.847 0 001.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 00.214-.869z" />
        </symbol>
      </defs>
    </svg>
    <div
      class="rating"
      style="--star-size: calc(var(--font-{{ type_preset }}--size) * 1.1);"
      aria-label="{{ 'accessibility.rating' | t: rating: rating }}"
    >
      {% if stars_style == 'single' %}
        <svg
          class="stars {% if svg_filled_stars > 0 %}filled-star{% endif %}"
          viewBox="0 0 32 32"
          style="--empty-star-fill-color: rgb(var(--star-fill-color-rgb) / var(--opacity-20))"
          role="presentation"
        >
          <use xlink:href="#star"></use>
        </svg>
      {% else %}
        {%- for star in (1..star_count_rating) -%}
          <svg
            class="stars {% if star <= svg_filled_stars %}filled-star{% endif %}"
            viewBox="0 0 32 32"
            style="--empty-star-fill-color:{% if stars_style == 'outline' %}transparent{% else %}rgb(var(--star-fill-color-rgb) / var(--opacity-20)){% endif %}"
            role="presentation"
          >
            <use xlink:href="#star"{% if decimal_rating == 0.5 and star == svg_filled_stars %} fill="url(#half)"{% endif %}></use>
            {% if stars_style == "outline" %}
              <use xlink:href="#star" fill="none" stroke="var(--star-fill-color)" stroke-width="var(--icon-stroke-width)"></use>
            {% endif %}
          </svg>
        {%- endfor -%}
      {% endif %}
    </div>

    {%- if show_number or stars_style == 'single' -%}
      <p class="rating-count {{ type_preset }}">
        {%- if stars_style == 'single' -%}
          <span aria-hidden="true">{{- rating | round: 1 }}</span>
        {%- endif -%}
        {%- if render_divider -%}
          <span class="rating-count-separator">|</span>
        {%- endif -%}
        {%- if show_number -%}
          {{- rating_count }}
          {%- if show_review_label -%}
            {{ 'content.reviews' | t }}
          {%- endif -%}
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>
{%- endif -%}

{% render 'product-rating-styles' %}
