{%- liquid
  assign metaobject_type = section.settings.metaobject_type | default: 'library_retail' | strip
  assign entries = shop.metaobjects[metaobject_type].values

  assign country_list = ''
  for entry in entries
    assign c = entry.country.value | strip
    if c != blank
      unless country_list contains c
        assign country_list = country_list | append: '|||' | append: c
      endunless
    endif
  endfor
  assign countries = country_list | remove_first: '|||' | split: '|||' | sort
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<retail-library
  class="retail-library section color-{{ section.settings.color_scheme }}{% unless section.settings.full_width %} page-width{% endunless %}"
  style="
    --retail-library-padding-block-start: {{ section.settings.padding-block-start }}px;
    --retail-library-padding-block-end: {{ section.settings.padding-block-end }}px;
    --retail-grid-columns: repeat({{ section.settings.columns }}, 1fr);
    --retail-grid-columns-tablet: repeat({{ section.settings.columns_tablet }}, 1fr);
    --retail-grid-columns-mobile: repeat({{ section.settings.columns_mobile }}, 1fr);
    --retail-grid-gap: {{ section.settings.gap }}px;
    --retail-card-aspect-ratio: {{ section.settings.card_aspect_ratio }};
  "
>
  {%- if section.settings.heading != blank -%}
    <h2 class="retail-library__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="retail-library__controls">
    <label class="retail-library__search">
      <span class="visually-hidden">{{ section.settings.search_label | default: 'Search partners' }}</span>
      <span class="retail-library__search-icon" aria-hidden="true">
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75">
          <circle cx="9" cy="9" r="6"/>
          <path d="m13.5 13.5 3.5 3.5" stroke-linecap="round"/>
        </svg>
      </span>
      <input
        type="search"
        class="retail-library__search-input"
        placeholder="{{ section.settings.search_placeholder | default: 'Search by name, city, or country' }}"
        autocomplete="off"
        spellcheck="false"
        data-search-input
      >
    </label>

    {%- if countries.size > 0 -%}
      <div class="retail-library__filter" role="group" aria-label="{{ section.settings.country_filter_label | default: 'Filter by country' }}">
        <button
          type="button"
          class="retail-library__filter-btn retail-library__filter-btn--active"
          data-country=""
          aria-pressed="true"
        >
          {{ section.settings.all_label | default: 'All countries' }}
        </button>
        {%- for country in countries -%}
          <button
            type="button"
            class="retail-library__filter-btn"
            data-country="{{ country | escape }}"
            aria-pressed="false"
          >
            {{ country }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="retail-library__grid" role="list" data-grid>
    {%- for entry in entries -%}
      {% render 'retail-library-card', entry: entry, index: forloop.index0 %}
    {%- else -%}
      <p class="retail-library__empty">
        {{ section.settings.empty_message | default: 'No retail partners yet. Add entries to the Library Retail metaobject in Shopify Admin.' }}
      </p>
    {%- endfor -%}
  </div>

  <p class="retail-library__no-matches" hidden data-no-matches>
    {{ section.settings.no_matches_message | default: 'No partners match your search.' }}
  </p>

  <dialog class="retail-library__dialog" aria-label="Partner details" data-dialog>
    <button
      type="button"
      class="retail-library__dialog-close"
      aria-label="Close partner details"
      data-dialog-close
    >
      <span aria-hidden="true">&times;</span>
    </button>
    <div class="retail-library__dialog-content" data-dialog-content></div>
  </dialog>
</retail-library>

<link rel="stylesheet" href="{{ 'retail-library.css' | asset_url }}">
<script src="{{ 'retail-library.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "Retail library",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Loops the Library Retail metaobject (type handle: library_retail). Each entry should have name, description, image_1, image_2, image_3, hours, city, state, and country fields. Customers can search by name/city/country and filter by country."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "metaobject_type",
      "label": "Metaobject type handle",
      "default": "library_retail",
      "info": "Must match the metaobject definition's type handle in Shopify Admin."
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search by name, city, or country"
    },
    {
      "type": "text",
      "id": "search_label",
      "label": "Search aria-label",
      "default": "Search partners"
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "\"All countries\" button label",
      "default": "All countries"
    },
    {
      "type": "text",
      "id": "country_filter_label",
      "label": "Country filter aria-label",
      "default": "Filter by country"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty state message",
      "default": "No retail partners yet. Add entries to the Library Retail metaobject in Shopify Admin."
    },
    {
      "type": "text",
      "id": "no_matches_message",
      "label": "No-matches message",
      "default": "No partners match your search."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Tablet columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between cards",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "card_aspect_ratio",
      "label": "Card image aspect ratio",
      "options": [
        { "value": "1", "label": "Square (1:1)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "3 / 2", "label": "Landscape (3:2)" },
        { "value": "16 / 9", "label": "Landscape (16:9)" }
      ],
      "default": "1"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Retail library"
    }
  ]
}
{% endschema %}
