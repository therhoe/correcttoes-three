        "text_ngtBPJ": {
          "type": "text",
          "name": "t:names.heading",
          "settings": {
            "text": "<h2>Arch Support That Starts at the Source</h2>",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
