            "text_aEtTtq": {
              "type": "text",
              "name": "Product description",
              "settings": {
                "text": "<p>Healthy feet start at the foundation. StableToe® helps keep that foundation strong.</p><ul><li>Assists in restoring big toe alignment — guiding it back into its natural position</li><li>Supports your main foot arch — encouraging healthier weight distribution</li><li>Improves balance and gait mechanics — helping you move with more efficiency</li><li>Helps relieve common foot issues — including bunions, neuromas, and plantar fasciosis</li><li>Promotes recovery from fatigue — by reducing stress on joints and soft tissues</li></ul>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-primary--family)",
                "font_size": "",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "color": "",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "text_fV4tgD": {
              "type": "text",
              "name": "t:names.text",
              "settings": {
                "text": "<p><strong>StableToe®</strong> is designed to restore balance and support by realigning your big toe to its natural position. </p><p>This helps activate and strengthen the muscle that supports your arch. Over time, your foot regains its structure, its strength—and that effortless spring in your step.</p><p>StableToe® zeroes in on the big toe and arch. It's simple, targeted, and easy to wear inside shoes, making it a great complement to your foot restoration toolkit.</p>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "color": "var(--color-foreground)",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "text_FBGVYW": {
              "type": "text",
              "name": "t:names.text",
              "settings": {
                "text": "<p><strong>StableToe </strong>is a <em>One-size-fits-most</em> toe spacer. Most comfortable for sizes <strong>W8-12 or M7-11</strong></p>",
