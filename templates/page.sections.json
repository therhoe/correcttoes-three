/*
 * ------------------------------------------------------------
 * Sections reference page.
 *
 * One instance of every theme section that is legal on a page
 * template. Group 1 = sections currently used on the site.
 * Group 2 = sections shipped with the theme but unused.
 *
 * Sections Shopify restricts to other templates or to the
 * header/footer groups are intentionally absent - see
 * docs/design-system.md.
 * ------------------------------------------------------------
 */
{
  "sections": {
    "main": {
      "type": "main-page",
      "settings": {}
    },
    "label_used": {
      "type": "section",
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "<h2>Group 1 — sections used on this site</h2>",
            "width": "100%",
            "alignment": "left",
            "type_preset": "h3"
          }
        }
      },
      "block_order": ["heading"],
      "settings": {
        "color_scheme": "scheme-2",
        "padding-block-start": 32,
        "padding-block-end": 32
      }
    },
    "used_hero": {
