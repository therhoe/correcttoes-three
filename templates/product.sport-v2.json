                  "blocks": {
                    "text_GWqk4n": {
                      "type": "text",
                      "settings": {
                        "text": "<h4>Correct Toes may be eligible for HSA/FSA reimbursement when used to treat a qualifying medical condition.</h4>",
                        "width": "fit-content",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
